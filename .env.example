# Vorlage für die lokale Konfiguration.
#   cp .env.example .env    und danach das Passwort ändern.
# Die Datei .env wird von Git ignoriert und darf NICHT committed werden.
# (In der Jenkins-Pipeline kommen die Werte stattdessen aus den Jenkins-Credentials.)

POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=bitte-aendern

# Prüfintervall in Sekunden
NETWATCH_INTERVAL=60
